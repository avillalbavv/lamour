# Comma-separated administrator email allowlist. Admin requires Supabase sign-in.
ADMIN_EMAILS=
# Canonical public origin, set to the deployed origin.
SITE_URL=
# Supabase public values. The publishable key is safe to expose to the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only. Create a dedicated sb_secret_ key in Supabase and store it as a
# Cloudflare Worker secret. Never expose it to browser code or commit it.
SUPABASE_SECRET_KEY=
