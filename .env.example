# Comma-separated administrator email allowlist. Admin requires ChatGPT sign-in.
ADMIN_EMAILS=
# Canonical public origin, set to the deployed origin.
SITE_URL=
# Supabase public values. The publishable key is safe to expose to the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose this key to browser code or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
